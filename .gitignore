# third-party tool trees — re-obtainable per dnd-mapping/docs/map-pipeline.md,
# EXCEPT the custom FMG headless runner, which is tracked under
# dnd-mapping/vendor-patches/fmg/ (see its README)
tools/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
# studio runtime artifacts
studio/logs/
# studio's crash-restore copy of the engine's state (created/deleted at runtime)
agentic-simulator/world/state.yaml.bak
agentic-simulator/world/.week-run-flag
# scratch
dnd-mapping/out-gen-city-smoke/

# session-local scratch (ZCode automations) and the engine home chronicle
# output dir — restored from the campaign on every week run
.zcode/
agentic-simulator/chronicle/

# the campaign workspace is its own nested git repository (canon snapshots
# live there, never in this parent repo) and the engine home is scratch
# restored from the campaign on every week run
campaigns/
agentic-simulator/world/

# LLM provider config (copy llm.env.example; the real one carries a key)
llm.env

# uv
.venv/
